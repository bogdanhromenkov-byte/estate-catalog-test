# Example environment variables
# Copy this file to .env and update values

# ВАЖНО: Сгенерируйте уникальный SECRET_KEY для production!
# Можно сгенерировать командой: python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=your-secret-key-here-change-in-production

# База данных (SQLite для простоты, хранится на сервере)
DATABASE_URL=sqlite:///estate.db

# Настройки Flask
FLASK_ENV=production

# Безопасность: Укажите домен вашего Bitrix24
# Например: https://your-company.bitrix24.ru или https://your-company.bitrix24.com
# Оставьте * только для разработки/тестирования
BITRIX24_DOMAIN=*

# CORS: Разрешенные домены для API (через запятую)
# Например: https://your-company.bitrix24.ru,https://another-domain.com
# Оставьте * только для разработки/тестирования
ALLOWED_ORIGINS=*
